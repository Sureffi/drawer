#!/bin/sh
# scripts/drawer — the plugin's hooks, one script.
#
#   drawer session    SessionStart: find this version's binary or put one
#                     in place, then print what a model should know —
#                     stdout of this event goes into the model's context.
#   drawer hook       MessageDisplay: the payload on stdin, the drawing out.
#   drawer element N [I]
#                     the hooks module's ui.render: one fence's DOT on
#                     stdin, its drawing out as JSON, for a screen N
#                     columns wide and a fence indented I columns (0 when
#                     not given). Exits 1 when no binary is found.
#
# A plugin runs no install step, so the binary is found here, or put in
# place at SessionStart. Four places it can come from, best first, each
# falling to the next:
#
#   a built checkout   bin/drawer beside go.mod: a developer's tree, run
#                      where it is, so a rebuild is live in the next reply
#   shipped            scripts/bin/drawer-OS-ARCH: the release zip, run
#                      where it is
#   downloaded         the release binary for this OS and ARCH, sha256
#                      pinned below by scripts/release.sh, put in the data
#                      directory as drawer-VERSION
#   built              go build, where Go is on the PATH: a checkout with
#                      no release for this platform, or none reachable; put
#                      in the data directory as drawer-VERSION
#
# A version runs its own binary and no other. The data directory is shared
# by every version of the plugin, and a session keeps the version it
# started with until it ends. Read off a machine on 2026-10-08: 0.4.0
# installed, sessions started under 0.1.0 still running, and data/drawer
# holding 0.1.0's binary, put there by a 0.1.0 SessionStart, which every
# 0.4.0 hook then ran. So nothing runs from a path another version writes:
# the first two run inside the version's own tree, the last two are named
# for the version. data/drawer is a link to the binary of the session that
# started last, for `drawer -doctor`, and for versions before this rule,
# which run it.
#
# Installed mid-session and reloaded, the hooks are registered but
# SessionStart is not fired (measured, Claude Code 2.1.261): the first two
# need nothing put in place, and a download or a build is not what a hook
# with a reply on screen does. Until a binary is found every hook fails
# open: {} is "display the original", and a session without the line of
# context is a fence that shows its source.
#
# Claude Code puts CLAUDE_PLUGIN_ROOT (this checkout) and CLAUDE_PLUGIN_DATA
# in a hook's environment, measured on 2.1.261, and so is every DRAWER_*
# variable set for claude — settings.json's env, or the shell — which the
# binary reads for itself. A hooks module's children get neither plugin
# variable (measured, 2.1.283): `element` finds the root from where this
# script is, and the data directory from the root. Claude Code keeps
# plugins under one base: CLAUDE_CODE_PLUGIN_CACHE_DIR when set, else
# CONFIG/plugins or CONFIG/cowork_plugins, CONFIG being CLAUDE_CONFIG_DIR
# or ~/.claude (read from 2.1.290). A root and its data directory:
#
#   cached       root BASE/cache/MARKETPLACE/PLUGIN/VERSION, data
#                BASE/data/PLUGIN-MARKETPLACE, every character outside
#                [A-Za-z0-9_-] a dash: a root whose third parent is named
#                cache has its data beside that cache
#   inline       a checkout loaded by --plugin-dir or CLAUDE_CODE_PLUGIN_DIRS,
#                data BASE/data/drawer-inline
#   directory    a directory marketplace's source folder, data
#                BASE/data/PLUGIN-MARKETPLACE; the root does not name the
#                marketplace, so `element` cannot derive it, and there the
#                checkout carries bin/drawer or scripts/bin
#
# A root that is not cached is looked for as inline.
#
# The binary is exec'd, never run as a child: it reads the terminal's size
# through its parent, and its parent has to be claude.

# release: rewritten by scripts/release.sh; the pins for this version's binaries.
release=0.4.0
release_url=https://github.com/sureffi/drawer/releases/download
sha_darwin_amd64=5d573d694efb7275dd8af70ff8e4941fe52a8ecbc5db704ce2338632ef15f94a
sha_darwin_arm64=b54a7d4769b16e574fa6944f2eb9bb947eba839f18e3f903a2e5a14f40970eb0
sha_linux_amd64=a7d4ad5a1d80ebae4afe29a72899bc4332ca26c1f8157701d2399fd84130ac5c
sha_linux_arm64=69f7cd5d1714593a0c8c5f99769fd329283e243ecfdbdd83a0576a8776a45eb5
# release end

mode=$1
root=${CLAUDE_PLUGIN_ROOT:-$(dirname "$0")/..}
root=$(cd "$root" && pwd) # absolute: a link into it must hold from anywhere
data=$CLAUDE_PLUGIN_DATA

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
aarch64 | arm64) arch=arm64 ;;
*) arch= ;;
esac
plat=$os-$arch

# own DATA prints this version's binary, the first of the four that is
# there, the last two looked for in DATA; it fails when none is.
own() {
	if [ -f "$root/go.mod" ] && [ -x "$root/bin/drawer" ]; then
		printf '%s\n' "$root/bin/drawer"
	elif [ -x "$root/scripts/bin/drawer-$plat" ]; then
		printf '%s\n' "$root/scripts/bin/drawer-$plat"
	elif [ -n "$1" ] && [ -x "$1/drawer-$release" ]; then
		printf '%s\n' "$1/drawer-$release"
	else
		return 1
	fi
}

# place FILE — the binary arrives beside itself and moves over, so a
# session mid-reply keeps the one it is running and two sessions starting
# at once never share a half-written file.
place() {
	chmod +x "$1" && mv -f "$1" "$data/drawer-$release"
}

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

from_release() {
	eval "want=\$sha_${os}_${arch}"
	[ -n "$want" ] || return 1
	command -v curl >/dev/null 2>&1 || return 1
	tmp=$data/drawer-$release.$$
	curl -fsSL --retry 2 --max-time 120 -o "$tmp" \
		"$release_url/v$release/drawer-$plat" 2>/dev/null || { rm -f "$tmp"; return 1; }
	if [ "$(sha256 "$tmp")" != "$want" ]; then
		rm -f "$tmp"
		echo "drawer: the downloaded binary is not the one pinned for v$release; not used" >&2
		return 1
	fi
	place "$tmp"
}

from_build() {
	[ -f "$root/go.mod" ] && command -v go >/dev/null 2>&1 || return 1
	tmp=$data/drawer-$release.$$
	if (cd "$root" && go build -o "$tmp" ./cmd/drawer) >&2; then
		place "$tmp"
	else
		rm -f "$tmp"
		return 1
	fi
}

case $mode in
session)
	[ -n "$data" ] || exit 0
	mkdir -p "$data"
	if ! bin=$(own "$data"); then
		from_release || from_build
		bin=$(own "$data") || {
			echo "drawer: no binary for $plat could be put in place; a dot fence shows its source" >&2
			exit 0
		}
	fi
	ln -sfn "$bin" "$data/drawer"
	exec "$bin" -context
	;;
hook)
	bin=$(own "$data") || { echo '{}'; exit 0; }
	exec "$bin" -hook
	;;
element)
	cols=${2:-0}
	indent=${3:-0}
	draw() { exec "$1" -element -cols "$cols" -indent "$indent"; }
	if [ -n "$data" ]; then
		bin=$(own "$data") && draw "$bin"
	else
		plugin=$(dirname "$root")
		market=$(dirname "$plugin")
		cache=$(dirname "$market")
		if [ "$(basename "$cache")" = cache ]; then
			name=$(printf '%s' "$(basename "$plugin")-$(basename "$market")" | tr -c 'A-Za-z0-9_-' -)
			bin=$(own "$(dirname "$cache")/data/$name") && draw "$bin"
		elif [ -n "$CLAUDE_CODE_PLUGIN_CACHE_DIR" ]; then
			bin=$(own "$CLAUDE_CODE_PLUGIN_CACHE_DIR/data/drawer-inline") && draw "$bin"
		else
			config=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
			bin=$(own "$config/plugins/data/drawer-inline") && draw "$bin"
			bin=$(own "$config/cowork_plugins/data/drawer-inline") && draw "$bin"
		fi
	fi
	echo "drawer: no binary for $plat found from $root; run a session to put one in place" >&2
	exit 1
	;;
*)
	echo "usage: drawer session|hook|element COLUMNS [INDENT]" >&2
	exit 2
	;;
esac
