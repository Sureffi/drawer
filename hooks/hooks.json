{
  "description": "SessionStart puts the binary in place and tells the model a dot fence draws; MessageDisplay draws it.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/drawer\" session",
            "statusMessage": "drawer: putting the binary in place"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/drawer\" hook"
          }
        ]
      }
    ]
  }
}
