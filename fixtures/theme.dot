// A second theme: the same tokyonight strokes over nodes the board shows
// through. Install it to compare against the built-in one:
//
//     drawer -install -theme fixtures/theme.dot
graph [bgcolor=transparent, pad=0.15, color="#565f89", fontcolor="#a9b1d6", style="rounded,dashed", penwidth=1]
node  [shape=box, style=rounded, fillcolor="#7aa2f71f", color="#7aa2f7", fontcolor="#c0caf5", penwidth=1.4]
edge  [color="#7aa2f7", fontcolor="#9ece6a", penwidth=1.2]
